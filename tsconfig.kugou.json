{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "../tests/compiled"
  },
  "include": ["src/main/kugou/**/*.ts", "src/shared/kugou.ts"]
}
